<?xml version="1.0" encoding="UTF-8"?>
<!--
  EwokVPN AppStream Metadata
  Place this file at: linux/packaging/myappid.appdata.xml
-->
<component type="desktop-application">
  <id>com.ewokvpn.app</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>

  <name>EwokVPN</name>
  <summary>Modern Proxy and VPN Manager for Linux</summary>

  <developer_name>EwokVPN</developer_name>

  <description>
    <p>
      EwokVPN is an advanced proxy and VPN client built for privacy and control. 
      It supports multiple backend protocols including V2Ray, Xray, Clash, and Sing-box, 
      providing flexibility and performance for all kinds of network configurations.
    </p>
    <p>
      Designed with simplicity in mind, EwokVPN helps users connect securely and 
      manage complex proxy configurations through a clean graphical interface.
    </p>
    <p>
      EwokVPN is based on Hiddify (https://github.com/hiddify/hiddify-app).
    </p>
  </description>

  <launchable type="desktop-id">ewokvpn.desktop</launchable>

  <icon type="stock">ewokvpn</icon>

  <categories>
    <category>Network</category>
  </categories>

  <keywords>
    <keyword>EwokVPN</keyword>
    <keyword>Proxy</keyword>
    <keyword>VPN</keyword>
    <keyword>V2Ray</keyword>
    <keyword>Nekoray</keyword>
    <keyword>Xray</keyword>
    <keyword>Psiphon</keyword>
    <keyword>OpenVPN</keyword>
  </keywords>

  <mime-types>
    <mime-type>x-scheme-handler/hiddify</mime-type>
    <mime-type>x-scheme-handler/v2ray</mime-type>
    <mime-type>x-scheme-handler/v2rayn</mime-type>
    <mime-type>x-scheme-handler/v2rayng</mime-type>
    <mime-type>x-scheme-handler/clash</mime-type>
    <mime-type>x-scheme-handler/clashmeta</mime-type>
    <mime-type>x-scheme-handler/sing-box</mime-type>
  </mime-types>

  <url type="homepage">https://github.com/HunterEwok/ewokvpn-hiddify-app</url>
  <url type="bugtracker">https://github.com/HunterEwok/ewokvpn-hiddify-app/issues</url>

  <provides>
    <binary>ewokvpn</binary>
  </provides>

  <releases>
    <release version="1.0.0" date="2025-10-25">
      <description>
        <p>Initial Linux release of EwokVPN with multi-protocol support and modern UI.</p>
      </description>
    </release>
  </releases>

  <translation type="gettext">ewokvpn</translation>

  <custom>
    <value key="PackageName">ewokvpn</value>
    <value key="Priority">optional</value>
    <value key="Section">x11</value>
    <value key="InstalledSize">6604</value>
    <value key="Essential">false</value>
  </custom>
</component>